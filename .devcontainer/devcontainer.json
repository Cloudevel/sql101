{
  "name": "sql101 · SQL para Ingeniería y Analítica de Datos (Cloudevel)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },

  "postCreateCommand": "python -m pip install --upgrade pip && pip install --no-cache-dir -r requirements.txt && python scripts/generar_datos.py && python scripts/cargar_datos.py",

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.notebookFileRoot": "${fileDirname}",
        "files.exclude": {
          "**/__pycache__": true,
          "**/.ipynb_checkpoints": true
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers"
      ]
    },
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  }
}
