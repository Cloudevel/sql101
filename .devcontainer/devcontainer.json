{
  "name": "Curso de SQL para ingeniería y analítica de datos",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.notebookFileRoot": "${workspaceFolder}"
      }
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  },
  "postCreateCommand": "pip install --user -r requirements.txt && python scripts/generar_datos.py && python scripts/cargar_datos.py"
}
